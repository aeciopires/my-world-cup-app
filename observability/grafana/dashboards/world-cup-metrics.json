  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "My World Cup App",
      "type": "dashboards",
      "tags": [
        "my-world-cup-app"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
